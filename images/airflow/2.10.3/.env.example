# Copy this file to .env and adjust as needed.
# .env is gitignored — each developer maintains their own.

# DAGs are synced via sync-dags.sh from the data-pipelines repo into ./dags.

# AWS Secrets Manager secret ID containing Airflow connections in JSON import format.
# The startup script will fetch this secret and import all connections on container start.
# Ask a team member for the secret name, or check the AWS console under Secrets Manager.
# Example: local-mwaa/connections
CONNECTIONS_SECRET_ID=
